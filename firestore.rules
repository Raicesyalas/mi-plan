rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(memberPath()); }
    function person() { return get(memberPath()).data.person; }

    // Cada nombre (N = Noel, K = Ninoska, S = Stefanie) se puede reclamar una sola vez
    match /people/{p} {
      allow read: if signedIn();
      allow create: if signedIn() && p in ['N', 'K', 'S']
        && request.resource.data.uid == request.auth.uid
        && !exists(memberPath());
    }
    // Acceso con nombre y PIN: cada nombre se registra una sola vez
    match /names/{p} {
      allow read: if true;
      allow create: if signedIn() && p in ['N', 'K', 'S']
        && request.resource.data.uid == request.auth.uid
        && !exists(memberPath());
    }
    match /members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.person in ['N', 'K', 'S']
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.person)).data.uid == uid;
    }
    // Registros diarios: privados de cada persona
    match /users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // Lista del súper: compartida entre los tres
    match /shop/{doc} {
      allow read, write: if isMember();
    }
    // Planes: Noel y Ninoska se ven entre sí; Stefanie ve los tres; el de Stefanie solo lo ve ella
    match /plans/{id} {
      allow read: if isMember() && (resource.data.owner == person()
        || (person() in ['N', 'K'] && resource.data.owner in ['N', 'K'])
        || person() == 'S');
      allow create, update: if isMember() && (request.resource.data.owner == person()
        || (person() in ['N', 'K'] && request.resource.data.owner in ['N', 'K']));
    }
  }
}
